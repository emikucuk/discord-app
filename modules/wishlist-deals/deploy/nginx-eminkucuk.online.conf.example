# eminkucuk.online üzerinde Astro sitesine ek reverse-proxy parçası.
# Bot: localhost:3100  →  https://eminkucuk.online/api/discord/wishlist/*

location /api/discord/wishlist/ {
    proxy_pass http://127.0.0.1:3100;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Discord imza doğrulaması için ham body korunmalı
    proxy_request_buffering on;
}
